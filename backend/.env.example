# SmileCraft Dental Clinic — Backend Environment Variables
# Copy to .env and fill in your actual values. NEVER commit .env to Git.

# Server
NODE_ENV=development
PORT=5000

# MongoDB — MongoDB Atlas connection string (or local URI for offline dev)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.quj54ms.mongodb.net/smilecraft?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.quj54ms.mongodb.net/smilecraft?retryWrites=true&w=majority

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=7d

# Admin initial credentials (used by seeder only — change after first login)
ADMIN_EMAIL=admin@smilecraft.demo
ADMIN_PASSWORD=Admin@12345

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Optional: Cloudinary (for cloud image storage — leave blank to use local storage)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
